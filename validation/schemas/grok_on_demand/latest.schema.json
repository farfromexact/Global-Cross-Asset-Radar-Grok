{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:radar:grok-on-demand:latest:v1",
  "title": "Grok Complete batch latest pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "information_cutoff_utc",
    "started_at_utc",
    "archive_mode",
    "manifest",
    "reports",
    "archive_repository"
  ],
  "properties": {
    "schema_version": {
      "const": "radar_latest_v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}\\+0800_[0-9a-f]{32}$"
    },
    "information_cutoff_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archive_mode": {
      "enum": [
        "isolated",
        "production"
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global",
        "commodities"
      ],
      "properties": {
        "global": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "markdown",
            "json"
          ],
          "properties": {
            "markdown": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "json": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "commodities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "markdown",
            "json"
          ],
          "properties": {
            "markdown": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "json": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    },
    "archive_repository": {
      "const": "farfromexact/Global-Cross-Asset-Radar-Grok"
    }
  }
}
